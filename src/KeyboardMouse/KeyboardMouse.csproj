<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>KeyboardMouse</RootNamespace>
    <AssemblyName>KeyboardMouse</AssemblyName>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- DPI awareness is declared in app.manifest (PerMonitorV2) as required by
         PLAN.md; silence the WinForms analyzer that prefers the project property. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Platforms>AnyCPU;x64</Platforms>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>0.4.4</Version>
    <Product>KeyboardMouse</Product>
    <Description>Control the mouse entirely from the keyboard.</Description>
    <!-- Ship a single KeyboardMouse.exe: no .pdb, no reference XML docs. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\tray-on.ico" />
    <EmbeddedResource Include="Assets\tray-off.ico" />
    <EmbeddedResource Include="Assets\app.ico" />
    <EmbeddedResource Include="Ui\guide.html" />
    <EmbeddedResource Include="Ui\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KeyboardMouse.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

</Project>
